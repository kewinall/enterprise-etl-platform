<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>synthetic_customer_daily</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>v0.2 synthetic pipeline for Airflow-to-Hop orchestration validation</description>
    <extended_description>Generates generic synthetic rows, adds a sequence, and writes the rows to the Hop execution log.</extended_description>
    <pipeline_version>0.2.0</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>RUN_ENV</name>
        <default_value>DEV</default_value>
        <description>Generic lifecycle environment name</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>portfolio</created_user>
    <created_date>2026/09/09 00:00:00.000</created_date>
    <modified_user>portfolio</modified_user>
    <modified_date>2026/09/09 00:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Generate synthetic rows</from>
      <to>Add record sequence</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Add record sequence</from>
      <to>Log synthetic rows</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Generate synthetic rows</name>
    <type>RowGenerator</type>
    <description>Generate generic sample records only.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <length>-1</length>
        <name>customer_segment</name>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <type>String</type>
        <nullif>synthetic-retail</nullif>
      </field>
      <field>
        <length>-1</length>
        <name>source_system</name>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <type>String</type>
        <nullif>generic-crm</nullif>
      </field>
      <field>
        <length>-1</length>
        <name>amount_text</name>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <type>String</type>
        <nullif>120.50</nullif>
      </field>
      <field>
        <length>-1</length>
        <name>environment_name</name>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <type>String</type>
        <nullif>${RUN_ENV}</nullif>
      </field>
    </fields>
    <limit>3</limit>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Add record sequence</name>
    <type>Sequence</type>
    <description>Add a deterministic synthetic record identifier.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <valuename>record_id</valuename>
    <use_database>N</use_database>
    <connection/>
    <schema/>
    <seqname>SEQ_</seqname>
    <use_counter>Y</use_counter>
    <counter_name/>
    <start_at>1</start_at>
    <increment_by>1</increment_by>
    <max_value>999999999</max_value>
    <attributes/>
    <GUI>
      <xloc>336</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Log synthetic rows</name>
    <type>WriteToLog</type>
    <description>Expose v0.2 pipeline output in Hop logs without persisting customer-like data.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <loglevel>log_level_basic</loglevel>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>v0.2 synthetic_customer_daily output</logmessage>
    <fields>
      <field><name>record_id</name></field>
      <field><name>customer_segment</name></field>
      <field><name>source_system</name></field>
      <field><name>amount_text</name></field>
      <field><name>environment_name</name></field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
