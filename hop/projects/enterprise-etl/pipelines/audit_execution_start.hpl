<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>audit_execution_start</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Insert one RUNNING execution attempt into PostgreSQL audit.</description>
    <pipeline_version>0.3.0</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter><name>RUN_ENV</name><default_value>DEV</default_value></parameter>
      <parameter><name>RUN_ID</name><default_value>synthetic-local-run</default_value></parameter>
      <parameter><name>ATTEMPT_NUMBER</name><default_value>1</default_value></parameter>
      <parameter><name>CORRELATION_ID</name><default_value>synthetic-local-correlation</default_value></parameter>
      <parameter><name>TRIGGER_TYPE</name><default_value>MANUAL</default_value></parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <created_user>portfolio</created_user>
    <created_date>2026/09/09 00:00:00.000</created_date>
    <modified_user>portfolio</modified_user>
    <modified_date>2026/09/09 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Generate one row</from><to>Resolve audit start fields</to><enabled>Y</enabled></hop>
    <hop><from>Resolve audit start fields</from><to>Insert execution attempt</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Generate one row</name>
    <type>RowGenerator</type>
    <description>Create one input row for runtime variable resolution.</description>
    <distribute>Y</distribute><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields></fields>
    <limit>1</limit><never_ending>N</never_ending><interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field><last_time_field>FiveSecondsAgo</last_time_field>
    <attributes/><GUI><xloc>80</xloc><yloc>112</yloc></GUI>
  </transform>
  <transform>
    <name>Resolve audit start fields</name>
    <type>GetVariable</type>
    <description>Resolve Airflow/Hop runtime parameters after parameter activation.</description>
    <distribute>Y</distribute><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><currency/><decimal/><format/><group/><length>-1</length><name>pipeline_name</name><precision>-1</precision><trim_type>none</trim_type><type>String</type><variable>synthetic_customer_daily</variable></field>
      <field><currency/><decimal/><format/><group/><length>-1</length><name>environment_name</name><precision>-1</precision><trim_type>none</trim_type><type>String</type><variable>${RUN_ENV}</variable></field>
      <field><currency/><decimal/><format/><group/><length>-1</length><name>run_id</name><precision>-1</precision><trim_type>none</trim_type><type>String</type><variable>${RUN_ID}</variable></field>
      <field><currency/><decimal/><format/><group/><length>-1</length><name>correlation_id</name><precision>-1</precision><trim_type>none</trim_type><type>String</type><variable>${CORRELATION_ID}</variable></field>
      <field><currency/><decimal/><format/><group/><length>-1</length><name>attempt_number</name><precision>0</precision><trim_type>none</trim_type><type>Integer</type><variable>${ATTEMPT_NUMBER}</variable></field>
      <field><currency/><decimal/><format/><group/><length>-1</length><name>status</name><precision>-1</precision><trim_type>none</trim_type><type>String</type><variable>RUNNING</variable></field>
      <field><currency/><decimal/><format/><group/><length>-1</length><name>trigger_type</name><precision>-1</precision><trim_type>none</trim_type><type>String</type><variable>${TRIGGER_TYPE}</variable></field>
    </fields>
    <attributes/><GUI><xloc>288</xloc><yloc>112</yloc></GUI>
  </transform>
  <transform>
    <name>Insert execution attempt</name>
    <type>TableOutput</type>
    <description>Persist RUNNING attempt; PostgreSQL trigger captures STARTED event.</description>
    <distribute>Y</distribute><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <commit>1</commit><connection>audit-postgres</connection>
    <fields>
      <field><column_name>pipeline_name</column_name><stream_name>pipeline_name</stream_name></field>
      <field><column_name>environment_name</column_name><stream_name>environment_name</stream_name></field>
      <field><column_name>run_id</column_name><stream_name>run_id</stream_name></field>
      <field><column_name>correlation_id</column_name><stream_name>correlation_id</stream_name></field>
      <field><column_name>attempt_number</column_name><stream_name>attempt_number</stream_name></field>
      <field><column_name>status</column_name><stream_name>status</stream_name></field>
      <field><column_name>trigger_type</column_name><stream_name>trigger_type</stream_name></field>
    </fields>
    <ignore_errors>N</ignore_errors><only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily><partitioning_enabled>N</partitioning_enabled><partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys><schema>etl_audit</schema><specify_fields>Y</specify_fields>
    <table>etl_execution_log</table><tablename_in_field>N</tablename_in_field><tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate><use_batch>N</use_batch><attributes/>
    <GUI><xloc>520</xloc><yloc>112</yloc></GUI>
  </transform>
  <transform_error_handling/><attributes/>
</pipeline>
