<?xml version="1.0" encoding="UTF-8"?>
<pipeline><info><name>eval_complex_parameters</name><parameters>
<parameter><name>RUN_DATE</name><default_value>2026-01-01</default_value><description>Synthetic run date</description></parameter>
<parameter><name>TARGET_SCHEMA</name><default_value>staging</default_value><description>Synthetic schema</description></parameter>
</parameters><variables><variable><name>LOAD_MODE</name><value>replace</value><scope>artifact</scope></variable></variables></info>
<transform><name>Read Parameterized</name><type>TableInput</type><schema>${TARGET_SCHEMA}</schema><table>orders</table></transform>
<transform><name>Write Snapshot</name><type>TableOutput</type><schema>analytics</schema><table>orders_snapshot</table></transform>
<order><hop><from>Read Parameterized</from><to>Write Snapshot</to><enabled>Y</enabled></hop></order></pipeline>
